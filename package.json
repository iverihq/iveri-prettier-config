{
  "name": "@iveri/prettier-config",
  "version": "0.1.0",
  "description": "Shared Prettier configuration for Iveri repos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iverihq/iveri-prettier-config.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "main": "index.json",
  "files": [
    "index.json",
    "README.md"
  ],
  "scripts": {
    "build": "echo \"@iveri/prettier-config ships JSON only — nothing to build\"",
    "test": "node ./scripts/verify-config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "./index.json",
  "peerDependencies": {
    "prettier": ">=3"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
